<mujoco model="five pandas">

  <statistic center="0.3 0 0.35" extent="1.3"/>

  <option timestep="0.005" integrator="implicitfast" solver="Newton" jacobian="sparse" cone="pyramidal"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="185" elevation="-22"/>
    <scale contactwidth="0.075" contactheight="0.025" forcewidth="0.05" com="0.05" framewidth="0.01" framelength="0.2"/>
  </visual>

  <default>
    <geom solref="0.01 1" solimp="0.95 0.99 0.0001" friction="1.5 0.005 0.0001"/>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table" rgba="0.3 0.33 0.38 1" reflectance="0.1"/>
    <model name="panda" file="panda.xml"/>
  </asset>

  <worldbody>
    <camera name="front" pos="1.6 0 0.8" fovy="58" mode="fixed" euler="0 1.2 1.5708"/>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" contype="1" conaffinity="1"/>
    <geom name="table" type="box" pos="0.55 0 0.1" size="0.15 0.75 0.1" material="table" contype="1" conaffinity="1"/>
    <replicate count="5" offset="0 0.25 0" sep="-">
      <frame pos="0 -0.5 0">
        <attach model="panda" body="link0" prefix="_"/>
      </frame>
    </replicate>
    <body name="object0" pos="0.5545 -0.50 0.216">
      <freejoint name="obj0_free"/>
      <geom name="obj0" type="box" size="0.015 0.020 0.016" contype="1" conaffinity="1" rgba="0.85 0.2 0.2 1" mass="0.05"/>
    </body>
    <body name="object1" pos="0.5545 -0.25 0.220">
      <freejoint name="obj1_free"/>
      <geom name="obj1" type="box" size="0.018 0.024 0.020" contype="1" conaffinity="1" rgba="0.2 0.75 0.3 1" mass="0.06"/>
    </body>
    <body name="object2" pos="0.5545  0.00 0.222">
      <freejoint name="obj2_free"/>
      <geom name="obj2" type="box" size="0.021 0.018 0.022" contype="1" conaffinity="1" rgba="0.2 0.5 0.9 1" mass="0.07"/>
    </body>
    <body name="object3" pos="0.5545  0.25 0.218">
      <freejoint name="obj3_free"/>
      <geom name="obj3" type="box" size="0.024 0.026 0.018" contype="1" conaffinity="1" rgba="0.95 0.8 0.1 1" mass="0.06"/>
    </body>
    <body name="object4" pos="0.5545  0.50 0.221">
      <freejoint name="obj4_free"/>
      <geom name="obj4" type="box" size="0.022 0.022 0.021" contype="1" conaffinity="1" rgba="0.8 0.25 0.8 1" mass="0.05"/>
    </body>
  </worldbody>
</mujoco>
